# Docker Compose reads this file as `.env` in the project root.
# Copy once:  copy .env.example .env  then set VITE_GOOGLE_CLIENT_ID.
# Local npm run dev still uses client/.env and server/.env — not this file.

VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_URL=http://localhost
COOKIE_SECURE=false
