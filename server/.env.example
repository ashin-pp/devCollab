# Local Mongo: mongodb://localhost:27017/Devcollab
# Atlas (database name after host /):
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/Devcollab?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/Devcollab
PORT=5000
# Local: http://localhost:5173
# Production (HTTPS): https://devcollab.space
CLIENT_URL=http://localhost:5173
# Production behind HTTPS: COOKIE_SECURE=true
# COOKIE_SECURE=false

JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
REFRESH_COOKIE_MAX_AGE=604800000

EMAIL_USER=
EMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

GEMINI_API_KEY=
GROQ_API_KEY=
# Groq model id (llama-3.1-8b-instant was retired 2026-08-16)
GROQ_MODEL=openai/gpt-oss-20b

# Razorpay (Dashboard → API Keys — use test keys in development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
