# Local Mongo: mongodb://localhost:27017/Devcollab
# Atlas (database name after host /):
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/Devcollab?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/Devcollab
PORT=5000
# Local: http://localhost:5173
# Docker on EC2 (HTTP): http://YOUR_PUBLIC_IP
CLIENT_URL=http://localhost:5173
# HTTP on a public IP: false. HTTPS later: true
COOKIE_SECURE=false

JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
REFRESH_COOKIE_MAX_AGE=604800000

EMAIL_USER=
EMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

GEMINI_API_KEY=
GROQ_API_KEY=

# Razorpay (Dashboard → API Keys — use test keys in development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
